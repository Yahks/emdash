{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "usstocks-admin",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "usstocks-db",
			"database_id": "180dde1d-e340-46e2-851e-9606f23352f9"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "usstocks-media"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
