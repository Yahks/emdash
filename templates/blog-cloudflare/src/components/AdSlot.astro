---
interface Props {
  slotId?: string;
  adClient?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

const { 
  slotId = "YOUR_AD_SLOT_ID", 
  adClient = "ca-pub-XXXXXXXXXXXXXXXX", 
  format = "auto",
  className = "" 
} = Astro.props;
---

<div class={`ad-container ${className}`}>
  <!-- Layout-Safe Wrapper: Auto-hides when empty, centered, overflow-protected -->
  <div class="ad-wrapper">
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={adClient}
         data-ad-slot={slotId}
         data-ad-format={format}
         data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
</div>

<style>
  .ad-container {
    width: 100%;
    max-width: 100%;
    margin: 1.5rem auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    min-height: 0;
  }

  /* Completely hides the slot if no ad is rendered (Zero broken blank spaces) */
  .ad-container:empty,
  .ad-wrapper:empty {
    display: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .ad-wrapper {
    width: 100%;
    text-align: center;
    max-width: 728px; /* Standard Leaderboard */
  }

  /* Responsive constraints for Mobile */
  @media (max-width: 768px) {
    .ad-wrapper {
      max-width: 320px; /* Standard Mobile Banner */
    }
  }
</style>
