---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Increased limit so editorial desks display ample market research
const POSTS_PER_PAGE = 12;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Remaining posts for the sector desks
const gridPosts = visiblePosts.filter((_, i) => i !== featuredIndex);

const entryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];

// Single batched query for both tags AND categories
const [tagsByEntry, categoriesByEntry] = await Promise.all([
	getTermsForEntries("posts", entryIds, "tag"),
	getTermsForEntries("posts", entryIds, "category"),
]);

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];
const featuredCategories = featuredPost
	? (categoriesByEntry.get(featuredPost.data.id) ?? []).map((c) => ({
			slug: c.slug,
			label: c.label,
		}))
	: [];
const featuredBylines = featuredPost?.data.bylines ?? [];

const gridPostsWithMeta = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	categories: (categoriesByEntry.get(post.data.id) ?? []).map((c) => ({
		slug: c.slug,
		label: c.label,
	})),
	bylines: post.data.bylines ?? [],
}));

// Collect unique categories present on posts for dynamic filter pills
const availableCategories = Array.from(
	new Map(
		gridPostsWithMeta
			.flatMap((p) => p.categories)
			.map((c) => [c.slug, c])
	).values()
);

function formatDate(date: Date | null | undefined) {
	if (!date) return null;
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<Base title={siteTitle} description={siteTagline}>
	{
		posts.length === 0 ? (
			<section class="empty-state">
				<h2>No market analysis published yet</h2>
				<p>Create your first equity research breakdown in the admin panel.</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">
					Write Market Report
				</a>
			</section>
		) : (
			<div class="home-content">
				{/* 1. FEATURED HERO POST - Title on TOP, Full-width Chart BELOW */}
				{featuredPost && (
					<section class="featured-section">
						<div class="featured-hero-container">
							<div class="featured-content">
								<div class="featured-meta">
									{featuredCategories.length > 0 && (
										<span class="sector-badge">{featuredCategories[0].label}</span>
									)}
									{featuredBylines.length > 0 && (
										<>
											<span class="featured-byline-name">
												{featuredBylines[0].byline.displayName}
											</span>
											<span class="meta-dot" />
										</>
									)}
									{formatDate(featuredPost.data.publishedAt) && (
										<time>{formatDate(featuredPost.data.publishedAt)}</time>
									)}
									<span class="meta-dot" />
									<span>{getReadingTime(featuredPost.data.content)} min read</span>
								</div>

								<a href={`/posts/${featuredPost.id}`} class="featured-title-link">
									<h1 class="featured-title">{featuredPost.data.title}</h1>
								</a>

								{featuredPost.data.excerpt && (
									<p class="featured-excerpt">{featuredPost.data.excerpt}</p>
								)}

								{featuredTags.length > 0 && (
									<div class="featured-tags">
										{featuredTags.map((tag) => (
											<a href={`/tag/${tag.slug}`} class="featured-tag">
												#{tag.label}
											</a>
										))}
									</div>
								)}
							</div>

							<a href={`/posts/${featuredPost.id}`} class="featured-image-link">
								<div class="featured-image">
									<Image image={featuredPost.data.featured_image} />
								</div>
							</a>
						</div>
					</section>
				)}

				{/* 2. S&P 500 SECTOR PERFORMANCE HEATMAP */}
				<section class="heatmap-section">
					<header class="section-header">
						<div>
							<h2 class="section-title">Market Pulse: S&P 500 Heatmap</h2>
							<p class="section-subtitle">Live performance by sector and market capitalization</p>
						</div>
					</header>

					<div class="heatmap-card">
						<div class="tradingview-widget-container">
							<div class="tradingview-widget-container__widget"></div>
							<script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-stock-heatmap.js" async is:inline>
							{
								"exchanges": [],
								"dataSource": "SPX500",
								"grouping": "sector",
								"blockSize": "market_cap_calc",
								"blockColor": "change",
								"locale": "en",
								"symbolUrl": "",
								"colorTheme": "dark",
								"hasTopBar": false,
								"isDataSetEnabled": false,
								"isZoomEnabled": true,
								"hasSymbolTooltip": true,
								"isMonoSize": false,
								"width": "100%",
								"height": "520"
							}
							</script>
						</div>
					</div>
				</section>

				{/* 3. LIVE MACRO & ECONOMIC CALENDAR */}
				<section class="calendar-section">
					<header class="section-header">
						<div>
							<h2 class="section-title">Macro Catalysts: Economic Calendar</h2>
							<p class="section-subtitle">Real-time US economic events: Fed interest rate decisions, CPI inflation, and jobs data</p>
						</div>
					</header>

					<div class="calendar-card">
						<div class="tradingview-widget-container">
							<div class="tradingview-widget-container__widget"></div>
							<script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-events.js" async is:inline>
							{
								"colorTheme": "dark",
								"isTransparent": false,
								"width": "100%",
								"height": "520",
								"locale": "en",
								"importanceFilter": "0,1",
								"countryFilter": "us"
							}
							</script>
						</div>
					</div>
				</section>

				{/* 4. SECTOR EDITORIAL DESKS WITH INTERACTIVE FILTERING */}
				{gridPostsWithMeta.length > 0 && (
					<section class="editorial-desks-section">
						<header class="desks-header">
							<div>
								<h2 class="section-title">Market Coverage & Research Desks</h2>
								<p class="section-subtitle">In-depth technical analysis, macro policy, and trade execution</p>
							</div>

							<!-- Interactive Filter Bar -->
							<div class="sector-filter-bar">
								<button class="filter-btn active" data-filter="all">All Coverage</button>
								{availableCategories.map((cat) => (
									<button class="filter-btn" data-filter={cat.slug}>
										{cat.label}
									</button>
								))}
							</div>
						</header>

						<div class="posts-grid" id="postsGrid">
							{gridPostsWithMeta.map(({ post, tags, categories, bylines }) => (
								<div 
									class="post-card-container" 
									data-categories={categories.map((c) => c.slug).join(",")}
								>
									<PostCard
										title={post.data.title ?? "Untitled"}
										excerpt={post.data.excerpt}
										featuredImage={post.data.featured_image}
										href={`/posts/${post.id}`}
										date={post.data.publishedAt ?? undefined}
										readingTime={getReadingTime(post.data.content)}
										tags={tags}
										bylines={bylines}
									/>
								</div>
							))}
						</div>
					</section>
				)}
			</div>
		)
	}

	<!-- ⚡ CLIENT-SIDE INSTANT SECTOR FILTER SCRIPT -->
	<script is:inline>
		function initSectorFilters() {
			const buttons = document.querySelectorAll(".filter-btn");
			const cards = document.querySelectorAll(".post-card-container");

			buttons.forEach((btn) => {
				btn.addEventListener("click", () => {
					buttons.forEach((b) => b.classList.remove("active"));
					btn.classList.add("active");

					const filter = btn.getAttribute("data-filter");

					cards.forEach((card) => {
						const cardCategories = card.getAttribute("data-categories") || "";
						if (filter === "all" || cardCategories.split(",").includes(filter)) {
							card.style.display = "block";
						} else {
							card.style.display = "none";
						}
					});
				});
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initSectorFilters);
		} else {
			initSectorFilters();
		}
	</script>
</Base>

<style>
	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	/* Hero Section */
	.featured-section {
		margin-bottom: var(--spacing-16);
		padding-bottom: var(--spacing-12);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.featured-hero-container {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
		max-width: 1000px;
		margin: 0 auto;
	}

	.featured-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		text-align: left;
	}

	.sector-badge {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		background: rgba(2, 132, 199, 0.15);
		color: #38bdf8;
		border: 1px solid rgba(56, 189, 248, 0.3);
	}

	.featured-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		column-gap: var(--spacing-3);
		row-gap: var(--spacing-1);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.featured-byline-name {
		font-weight: 600;
		color: var(--color-text);
	}

	.featured-title-link {
		text-decoration: none;
		color: inherit;
	}

	.featured-title {
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		transition: color var(--transition-fast);
		margin: var(--spacing-1) 0;
	}

	.featured-title-link:hover .featured-title {
		color: var(--color-brand);
	}

	.featured-excerpt {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 850px;
	}

	.featured-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-1);
	}

	.featured-tag {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.featured-tag:hover {
		color: var(--color-brand);
	}

	.featured-image-link {
		display: block;
		width: 100%;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
	}

	.featured-image {
		width: 100%;
		background: var(--color-surface);
	}

	.featured-image img {
		width: 100%;
		height: auto;
		max-height: 540px;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 0.4s ease;
		display: block;
	}

	.featured-image-link:hover .featured-image img {
		transform: scale(1.015);
	}

	/* Section Headers */
	.section-header {
		margin-bottom: var(--spacing-6);
	}

	.section-title {
		font-size: var(--font-size-base);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-brand);
	}

	.section-subtitle {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-top: 3px;
	}

	/* Heatmap & Calendar Cards */
	.heatmap-section,
	.calendar-section {
		margin-bottom: var(--spacing-16);
		padding-bottom: var(--spacing-12);
		border-bottom: 1px solid var(--color-border-subtle);
		width: 100%;
	}

	.heatmap-card,
	.calendar-card {
		width: 100%;
		height: 520px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		background: #0f172a;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
	}

	/* Editorial Desks Layout */
	.editorial-desks-section {
		margin-top: var(--spacing-10);
	}

	.desks-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	/* Sector Filter Pills */
	.sector-filter-bar {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.filter-btn {
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		color: var(--color-text-secondary);
		padding: 0.4rem 0.9rem;
		border-radius: 9999px;
		font-size: var(--font-size-xs);
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.filter-btn:hover {
		color: var(--color-text);
		border-color: var(--color-border);
	}

	.filter-btn.active {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border-color: var(--color-brand);
		box-shadow: 0 0 12px rgba(2, 132, 199, 0.35);
	}

	/* Posts Grid */
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-10) var(--spacing-8);
	}

	.post-card-container {
		width: 100%;
		transition: opacity 0.3s ease;
	}

	/* Empty State */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 450px;
		margin: 0 auto;
	}

	.empty-state h2 {
		font-size: var(--font-size-2xl);
		font-weight: 700;
	}

	.btn {
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.heatmap-card,
		.calendar-card {
			height: 440px;
		}

		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.home-content {
			padding: var(--spacing-4) var(--spacing-4) var(--spacing-12);
		}

		.featured-title {
			font-size: 2rem;
		}

		.desks-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.sector-filter-bar {
			width: 100%;
			flex-wrap: nowrap;
			padding-bottom: 0.5rem;
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}
	}
</style>
